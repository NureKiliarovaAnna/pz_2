# --- Network access (never commit the real .env) ---
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# --- Deployment parameters (empty = deployer address) ---
TOKEN_HOLDER=
ADMIN_ADDRESS=
PROPOSER_ADDRESS=
GUARDIAN_ADDRESS=
# Voting period in seconds, from 60 to 2592000 (30 days)
VOTING_PERIOD=400
# ETH sent to the treasury right after deployment
INITIAL_DEPOSIT_ETH=0
# Optional DVT distribution from the deployer: "0xAddr1:400,0xAddr2:100"
TOKEN_DISTRIBUTION=

# --- Tools ---
REPORT_GAS=false
